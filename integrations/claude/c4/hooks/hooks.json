{
  "hooks": {
    "PreToolUse": [{
      "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/c4-hook.mjs", "timeout": 30 }]
    }],
    "PostToolUse": [{
      "matcher": "Bash|PowerShell|Read|Glob|Grep|WebFetch|WebSearch|mcp__.*",
      "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/c4-hook.mjs", "timeout": 30 }]
    }]
  }
}
